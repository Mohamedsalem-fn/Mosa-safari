    "OWNER_WHATSAPP_PHONES": "201023355550",
    "EMAIL_FROM": "Mosa Safari <bookings@mosasafari.com>",
    "STOREFRONT_URL": "https://mosa-safari.mohamedsalem-fn.workers.dev"
  }
}
