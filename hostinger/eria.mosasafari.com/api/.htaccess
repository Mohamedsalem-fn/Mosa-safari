# Defense-in-depth lock for Hostinger admin /api/ directory
Options -Indexes
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</IfModule>
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^_lib/ - [R=404,L]
</IfModule>
